# Infra bot environment.
#
# Bare metal (`python main.py`): only the two TELEGRAM_* vars below are read
# from here — everything DigitalOcean-related is read from ../../deploy/.env.
#
# Docker (`docker compose up -d`): compose loads ../../deploy/.env first (if it
# exists) and then this file, which wins on conflicts. So you can either keep
# filling deploy/.env as before and leave the DigitalOcean block here empty, or
# ignore deploy/.env entirely and fill everything in this one file. The
# container entrypoint renders the values back into /app/deploy/.env, which is
# what rc_deploy's loader actually reads (deploy/rc_deploy/config.py:93).

# ── Telegram (required) ───────────────────────────────────────────
# Token from @BotFather (https://t.me/BotFather → /newbot).
# This must be a DIFFERENT BotFather bot from the Agent bot at bot/agent/.
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Numeric Telegram user id allowed to use /up and /down.
# Get it from @userinfobot. Same person can talk to both bots — use the same
# id here and in bot/agent/.env. Every other user is silently ignored.
ALLOWED_TELEGRAM_USER_ID=123456789

# ── DigitalOcean (required unless already in ../../deploy/.env) ───
# Create at: https://cloud.digitalocean.com/account/api/tokens
# Needs read+write on droplets and domains.
DO_API_TOKEN=dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fingerprint of an SSH key already uploaded to DigitalOcean.
# List with: doctl compute ssh-key list
DO_SSH_KEY_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99

# Droplet shape. The image already defaults to these three values, so you only
# need them if you want something else.
#DO_REGION=fra1
#DO_SIZE=s-1vcpu-1gb
#DO_IMAGE=ubuntu-24-04-x64

# ── DNS (required unless already in ../../deploy/.env) ────────────
# The domain must already be managed by DigitalOcean DNS.
# Confirm with: doctl compute domain list
DOMAIN=example.com
#DNS_TTL=60
# SUBDOMAIN is NOT set here — the bot picks it per deploy from the inline
# keyboard (rc / rc1 / rc2 / rc3, see handlers.py:34).

# ── Google OAuth (required unless already in ../../deploy/.env) ───
# Baked into the web bundle and verified by the server on sign-in.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_ALLOWED_EMAILS=you@example.com
GOOGLE_ALLOWED_DOMAINS=

# ── Deploy SSH key (Docker only) ──────────────────────────────────
# HOST path of the private key matching DO_SSH_KEY_FINGERPRINT. docker-compose.yml
# mounts it read-only at /run/secrets/ssh_key; the entrypoint then makes a 0600
# copy inside the container. Use an absolute path if ~ gives you trouble.
SSH_KEY_HOST_PATH=~/.ssh/id_ed25519
# Alternative to the mount (e.g. when you only pass an env file):
#SSH_PRIVATE_KEY_B64=<base64 of the private key, single line>

# ── Optional server tuning (defaults shown) ───────────────────────
#ACCESS_TOKEN_EXPIRE_MINUTES=60
#WS_SESSION_TIMEOUT_SECONDS=3600
#TURN_TTL_SECONDS=3600

# SECRET_KEY, AGENT_TOKENS and TURN_SECRET are deliberately absent: the bot
# generates fresh ones on every /up (handlers.py:157) and hands the agent token
# plus TURN secret to the Agent bot inside the base64 blob.
